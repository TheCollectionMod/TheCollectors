# You may find this .hjson file approach to translations easier for your mod.
# .hjson files contain translations for the language specified in the filename. (Make sure this file is UTF-8 encoded only.)
# The possible languages are: English ("en-US"), German ("de-DE"), Italian ("it-IT"), French ("fr-FR"), Spanish ("es-ES"), Russian ("ru-RU"), Chinese ("zh-Hans"), Portuguese ("pt-BR"), and Polish ("pl-PL")
# Here in ExampleMod we have organized these files in a folder called Localization. A single file per language makes it extremely easy to to integrate and maintain translations.
# Each translation entry in .hjson files contains a key and a value. The key is determined following the rules of JSON [https://www.w3schools.com/js/js_json_syntax.asp]
# The Key automatically inherits "Mods.ModNameHere.", which is useful to know if you want to use substitutions (as seen in the Paper Airplane example) or use Language.GetTextValue or Network text.
# The following are the currently autogenerated keys: ItemName, ItemTooltip, BuffName, BuffDescription, ProjectileName, NPCName, MapObject, and Prefix

Mods: {
	TheCollectors: {
		NPCs: {
			#............................................................................................................TownNPCs
			CandyElf: {
				DisplayName: Elfe des Bonbons

				TownNPCMood: {
					Content: Salut salu ! Aujourd'hui, j'ai la pêche d'enfer, voisinounet!.
					NoHome: Pas avoir ma p'tite cabane, ça m'achale un brin, tu sais. C'est comme avoir une guêpe dans le bonnet !.
					FarFromHome: J'me sens un brin dépaysé, comme un p'tit minou sans sa gratte à puces !.
					LoveSpace: Sapristi que c'est douillet ! Avoir toute cette place, c'est comme si j'avais gagné une manche des « Jeux des Lutins à la guimauve » ! Encore plus confortable que la poche d'un kangourou, tu l'as dit, bouffi !.
					DislikeCrowded: Bonté divine ! J'me sens pas ben à l'aise avec tout ce monde autour, moé. C'est comme une ruche pendant la cueillette du miel à la p'tite ferme des Lutins à la guimauve !.
					HateCrowded: Sapristi ! J'aime pas pantoute que ça soit aussi étouffant. C'est aussi tannant qu'un pic-bois à 5 heures du matin ! Pis c'est pas peu dire, tu l'as dit, bouffi !.
					LikeBiome: Oh que je me sens douillounet dans {BiomeName}, aussi douillounet que quand je prends une p'tite tasse fumounette de chocolat choupinet après ma p'tite journée de labeurounet !.
					DislikeBiome: Ô douceur ! {BiomeName}, j'aime pas d'même pantoute, moi. C'est comme un œil de démon qui viendrait toc-toc-ter à ta p'tite portounette en plein milieu de la nuitounette ! Brrr, ça me donne des frissonsounets !.
					HateBiome: Pour être ben honnête, {BiomeName} ça m'donne un p'tit brin la chaire de poule. C'est comme quand j'ai vu le Père Noël sans son costume, pis c'est pas peu dire, tu l'as dit, bouffi !.
					LoveNPC: Ô joie céleste ! J'adore de tout mon cœurounet {NPCName} ! Savez-vous que toute l'année, y travaille sans relâchounet pour préparer la belle nuitounette de Noël ? *Une petite goutte de sueur froide glisse sur son frontounet* Brrr, ça m'en donne des frissonsounets !.
					LikeNPC_Princess: Sapristi ! La princesse {NPCName}, c'est sûrement la personne la plus douce que j'connais, cher voisinounet. Aussi douce que les p'tits bonbons qu'on fabrique à Bonbonville ! C'est un vrai paradis sucré, diddly-doux !.
					Princess_LovesNPC: "{NPCName}, c'est une vraie p'tite perle ! Toujours pleine d'énergie, comme un lutin en plein préparatifs de Noël."
					LoveBiome: Ô merveille ! J'suis ravi d'amourounet pour le {BiomeName}. C'est comme un p'tit bout d'paradisounet sur terreounette. Une vraie douceur céleste, diddly-doux !.
					LikeNPC: Mais c'est mon amie {NPCName} ! Jaser avec elle, c'est comme une p'tite veillée autour du feu avec des guimauves en plein milieu de la montagne!.
					DislikeNPC: "{NPCName} arrête pas de m'achaler avec ses affaires. Y fait juste se vanter de ses meubles. J'pense que j'vas aller chercher d'la météorite durcie pour fabriquer les miens. Pis y vont être ben plus beaux, tu l'as dit, bouffi !."
					HateNPC: Faut que j'avoue que j'suis pas ben fan de {NPCName}. Y était pas si pingre avant, mais y a complètement changé après... *regarde par terre pis continue à marmonner dans sa barbe*.
				}

				Census.SpawnCondition: Avoir un bloc de sucre d'orge [i:CandyCaneBlock] à l'inventaire
			}

			Enchanter: {
				DisplayName: Enchanteur

				TownNPCMood: {
					Content: Merci d'avoir brisé le sortilège.
					NoHome: Dehors c'est ok mais j'ai besoin d'une chambre pour bosser sur mes cannes.
					LoveSpace: En {BiomeName} je peux me concentrer à fond.
					FarFromHome: Une escapade de temps en temps fait du bien, mais c'est l'heure du retour, n'est-ce pas?.
					DislikeCrowded: On ne respire pas beaucoup de magie, hein? Il faut laisser la circuler.
					HateCrowded: Si quelqu'un vient me demander des lapins de mon chapeau... Je déménage à l'océan, et je le déteste !.
					LikeBiome: En {BiomeName} on respire de la magie.
					DislikeBiome: Dans {BiomeName} je me distrais trop, je deviens oisif.
					HateBiome: Il vaut mieux que tu construises une chambre pour moi ailleurs plus lumineuse. J'en ai eu trop...
					LoveNPC: Dommage que {NPCName} aime autant la jungle, sa magie me semble très intéressante.
					LikeNPC: Avec {NPCName} ici, la fête est garantie.
					DislikeNPC: Je ne sais pas pourquoi on appelle {NPCName} le gobelin bricoleur. Il est plutôt le gobelin prétentieux.
					// HateNPC: I hate metal things.
					LikeNPC_Princess: "{NPCName} semble agréable."
					Princess_LovesNPC: "{NPCName} m'invite toujours goûter ses brassages. J'aime bien sa fiole de pétales avec arôme de cerises."
				}

				Census.SpawnCondition: Libère-lui du donjon
			}

			EnchanterPrisioner.DisplayName: Enchanteur enchanté

			McMoneyPants: {
				DisplayName: Gacha Gars

				TownNPCMood: {
					Content: Héhé, des nouveaux voisins auxquels rouler..., je veux dire, vendre mes fabuleux produits.
					NoHome: J'aurai besoin d'assez d'espace, un bon entrepôt, avec un coffre-fort, bien sûr.
					LoveSpace: La forêt est le meilleur endroit pour mon magasin. Du sol à bas prix que personne ne veut.
					FarFromHome: Non non non non, ici c'est un endroit horrible. Qui viendra acheter ici?.
					DislikeCrowded: La plupart des gens n'aiment pas le grouillement, mais moi si, plus de gens, plus de commerce.
					HateCrowded: Regarde autant de gens!, c'est l'heure de monter les prix.
					LoveBiome: Ici on sent du commerce.
					LikeBiome: ...
					DislikeBiome: ...
					HateBiome: ...
					LoveNPC: C'est bon de laisser les autres administrer leur argent, {NPCName} le sait bien.
					LikeNPC: J'adore que {NPCName} mette un prix aux ses serveis, la privatisation est le futur.
					DislikeNPC: ...
					HateNPC: ...
					LikeNPC_Princess: "{NPCName} est une princesse ? Quelle merveille, ils sont tous des candides..."
					Princess_LovesNPC: J'aime bien {NPCName}.
				}

				Census.SpawnCondition: Avoir une Terra Coin [i:TheCollectors/TerraCoin] dans l'inventaire
			}

			Meteorman: {
				DisplayName: L'Homme-météore

				TownNPCMood: {
					Content: Quelle terre verte et peu rocheuse, très bonne pour mes loisirs.
					NoHome: On peut utiliser les pièces restants de mon accident pour construire des maisons, il vaut mieux ne pas les gaspiller.
					LoveSpace: Il règne une atmosphère de paix.
					FarFromHome: Je ne me trouve pas à l'aise si loin de chez moi. Mais chez moi c'est à des miliers de kilomètres.
					DislikeCrowded: Ma liste de commandes commence à saturer.
					HateCrowded: Je n'aime pas l'accepter, mais avec autant de gens, je ne peux pas suivre le rythme des commandes.
					LikeBiome: Pour l'instant j'aimerais rester en {BiomeName}, même si le soir il rafraîchit.
					LoveBiome: cuando pueda
					DislikeBiome: "{BiomeName} est fantastique, mais je ne me sens pas sûr si proche de l'eau."
					HateBiome: Si je reste un jour plus dans {BiomeName}, je crois que l'on m'appellera l'homme de pierre quelconque.
					LikeNPC: J'aime bien {NPCName}, elle prend soin de la nature.
					LikeNPC_Princess: "{NPCName} s'entend bien avec tout le monde, comme il faudrait."
					LoveNPC: Ma boîte et celle de {NPCName} marchent très bien ensemble.
					// DislikeNPC: No tiene.
					HateNPC: Je n'aime pas {NPCName}, il profite de tout le monde. En plus il déteste le Père Noël.
					Princess_LovesNPC: J'aime bien {NPCName}.
				}

				Census.SpawnCondition: Sauvé après la chute d'un météorite.
			}

			MeteormanBroken.DisplayName: L'Homme-météore brisé

			Ninja: {
				DisplayName: Ninja

				TownNPCMood: {
					Content: J'aime bien le résultat de ce quartier.
					NoHome: Je m'entraîne pour n'avoir pas besoin d'une maison, mais en avoir une ferait du bien.
					LoveSpace: Je tuerais pour une maison dans la forêt....
					FarFromHome: C'est l'heure du retour, j'ai des tâches à faire.
					DislikeCrowded: Pourquoi les gens courent si bizarrement?.
					HateCrowded: Trop de gens, il vaut mieux qu'ils ne touchent mes Shurikens.
					LoveBiome: No tiene.
					LikeBiome: J'aime {BiomeName}, ça me rappelle mes années d'entraînement avec Master-San.
					DislikeBiome: 7.8 trop de {BiomeName}.
					HateBiome: Trop de couleurs dans {BiomeName}.
					LoveNPC: Je m'entraîne mieux quand {NPCName} est disponible.
					LikeNPC: no tiene
					LikeNPC_Princess: Voir {NPCName} c'est comme être dans un RPG.
					DislikeNPC: D'abord il kidnappe mon maître, et maintenant {NPCName} a le toupet de déménager ici?.
					HateNPC: "{NPCName} me rappelle des moments gélatineux... et pas des bons."
					Princess_LovesNPC: J'aime bien {NPCName}.
				}

				Census.SpawnCondition: Tuer le Roi Slime
				// DeathMessage: Mods.TheCollectors.NPCs.Ninja.DeathMessage
			}

